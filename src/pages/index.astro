---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
---

<BaseLayout>
  <!-- Hero Section -->
  <Section background="white" padding="lg" class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-title">
          Digital experiences that drive <span class="highlight">results</span>
        </h1>
        <p class="hero-description text-large">
          We design and build websites for brands that are serious about growth. Clean code, beautiful design, and measurable impact.
        </p>
        <div class="hero-cta">
          <Button variant="accent" size="lg" href="#contact">
            Get Started
          </Button>
          <Button variant="primary" size="lg" href="#work">
            View Work
          </Button>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-shapes">
          <div class="shape shape-1"></div>
          <div class="shape shape-2"></div>
          <div class="shape shape-3"></div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Stats Section -->
  <Section background="gray" padding="lg">
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-number">127%</div>
        <div class="stat-label">Average conversion increase</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">3.2x</div>
        <div class="stat-label">Return on investment</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">98%</div>
        <div class="stat-label">Client satisfaction</div>
      </div>
    </div>
  </Section>

  <!-- Services Section -->
  <Section background="white" padding="lg" class="services" id="services">
    <h2 class="section-title text-center">
      What we do
    </h2>
    <p class="section-subtitle text-center text-large">
      Full-service design and development for modern brands
    </p>

    <div class="services-grid">
      <Card title="Web Design">
        <p>
          User-focused interfaces that look great and perform better. Every pixel serves a purpose.
        </p>
        <div class="card-cta">
          <Button variant="primary" href="#contact">Learn More</Button>
        </div>
      </Card>

      <Card title="Brand Identity">
        <p>
          Visual systems that make you memorable. Logo, typography, colors—designed to scale with your business.
        </p>
        <div class="card-cta">
          <Button variant="primary" href="#contact">Learn More</Button>
        </div>
      </Card>

      <Card title="Development">
        <p>
          Fast, scalable websites built with modern tech. Clean code that's easy to maintain and built to last.
        </p>
        <div class="card-cta">
          <Button variant="primary" href="#contact">Learn More</Button>
        </div>
      </Card>

      <Card title="Strategy">
        <p>
          Data-informed decisions that move metrics. We optimize for the outcomes that matter to your business.
        </p>
        <div class="card-cta">
          <Button variant="primary" href="#contact">Learn More</Button>
        </div>
      </Card>

      <Card title="Content">
        <p>
          Clear messaging that resonates. We help you say the right thing to the right people at the right time.
        </p>
        <div class="card-cta">
          <Button variant="primary" href="#contact">Learn More</Button>
        </div>
      </Card>

      <Card title="Support">
        <p>
          Ongoing maintenance and optimization. We're here to help your site evolve as your business grows.
        </p>
        <div class="card-cta">
          <Button variant="primary" href="#contact">Learn More</Button>
        </div>
      </Card>
    </div>
  </Section>

  <!-- Work Section -->
  <Section background="dark" padding="lg" class="work" id="work">
    <h2 class="section-title text-center">
      Selected work
    </h2>
    <p class="section-subtitle text-center text-large">
      Recent projects and their impact
    </p>

    <div class="work-grid">
      <div class="work-item">
        <div class="work-image work-image-1"></div>
        <div class="work-info">
          <h3>TechStart SaaS</h3>
          <p>Platform redesign. 156% conversion increase, 42% lower bounce rate.</p>
          <div class="work-tags">
            <span class="tag">Design</span>
            <span class="tag">Development</span>
            <span class="tag">Strategy</span>
          </div>
        </div>
      </div>

      <div class="work-item">
        <div class="work-image work-image-2"></div>
        <div class="work-info">
          <h3>EcoLife</h3>
          <p>E-commerce build. 3x online sales in six months.</p>
          <div class="work-tags">
            <span class="tag">Branding</span>
            <span class="tag">E-commerce</span>
            <span class="tag">UX</span>
          </div>
        </div>
      </div>

      <div class="work-item">
        <div class="work-image work-image-3"></div>
        <div class="work-info">
          <h3>FinTech Pro</h3>
          <p>Dashboard interface. 89% improvement in user engagement.</p>
          <div class="work-tags">
            <span class="tag">UI/UX</span>
            <span class="tag">Web App</span>
            <span class="tag">Data Viz</span>
          </div>
        </div>
      </div>
    </div>

    <div class="work-cta text-center">
      <Button variant="accent" size="lg" href="#contact">
        Start a project
      </Button>
    </div>
  </Section>

  <!-- Process Section -->
  <Section background="white" padding="lg" class="process" id="process">
    <h2 class="section-title text-center">
      How we work
    </h2>
    <p class="section-subtitle text-center text-large">
      A structured approach from concept to launch
    </p>

    <div class="process-grid">
      <div class="process-step">
        <div class="step-number">01</div>
        <h3>Discovery</h3>
        <p>
          We start by understanding your business, goals, and users. Research informs every decision.
        </p>
      </div>

      <div class="process-step">
        <div class="step-number">02</div>
        <h3>Design</h3>
        <p>
          High-fidelity designs focused on usability and impact. We iterate until it's right.
        </p>
      </div>

      <div class="process-step">
        <div class="step-number">03</div>
        <h3>Development</h3>
        <p>
          Clean code, modern stack. Fast, accessible, and built to scale with your business.
        </p>
      </div>

      <div class="process-step">
        <div class="step-number">04</div>
        <h3>Launch & Growth</h3>
        <p>
          Ship to production, measure performance, and continuously improve based on data.
        </p>
      </div>
    </div>
  </Section>

  <!-- Contact Section -->
  <Section background="gradient" padding="lg" class="contact" id="contact">
    <div class="contact-content">
      <h2 class="section-title text-center">
        Let's build something
      </h2>
      <p class="section-subtitle text-center text-large">
        Ready to start your project? Get in touch.
      </p>

      <div class="contact-cta">
        <Button variant="accent" size="lg" href="mailto:hello@innovistadesign.com">
          Email us
        </Button>
      </div>

      <div class="contact-info">
        <p class="text-center">
          <a href="mailto:hello@innovistadesign.com" class="contact-link">hello@innovistadesign.com</a>
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 1400px;
    height: 100%;
    background: radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.15) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .hero-content {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 1.05;
    margin-bottom: var(--space-lg);
    animation: fadeInUp 0.8s ease-out;
  }

  .highlight {
    background: linear-gradient(135deg, var(--color-brand-primary), var(--color-brand-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    color: var(--color-gray-400);
    margin-bottom: var(--space-xl);
    animation: fadeInUp 0.8s ease-out 0.2s backwards;
    max-width: 600px;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    animation: fadeInUp 0.8s ease-out 0.4s backwards;
  }


  /* Hero Visual */
  .hero-visual {
    position: relative;
    height: 500px;
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-visual {
      display: block;
    }
  }

  .hero-shapes {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .shape {
    position: absolute;
    border-radius: var(--radius-xl);
    animation: float 6s ease-in-out infinite;
  }

  .shape-1 {
    width: 300px;
    height: 300px;
    background: linear-gradient(135deg, var(--color-brand-primary), var(--color-brand-secondary));
    top: 0;
    left: 0;
    opacity: 0.8;
  }

  .shape-2 {
    width: 200px;
    height: 200px;
    background: var(--color-accent-primary);
    top: 150px;
    right: 50px;
    opacity: 0.6;
    animation-delay: 1s;
  }

  .shape-3 {
    width: 150px;
    height: 150px;
    background: var(--color-brand-primary-light);
    bottom: 50px;
    left: 100px;
    opacity: 0.5;
    animation-delay: 2s;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  /* Section Titles */
  .section-title {
    margin-bottom: var(--space-md);
  }

  .section-subtitle {
    max-width: 700px;
    margin: 0 auto var(--space-3xl);
  }

  /* Stats Section */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-2xl);
    max-width: 1000px;
    margin: 0 auto;
  }

  .stat-item {
    text-align: center;
    padding: var(--space-2xl) var(--space-xl);
    background: transparent;
    border-top: 2px solid rgba(99, 102, 241, 0.5);
    transition: all var(--transition-base);
  }

  .stat-item:hover {
    border-top-color: var(--color-brand-primary);
  }

  .stat-number {
    font-size: clamp(3rem, 5vw, 4rem);
    font-weight: 800;
    background: linear-gradient(135deg, var(--color-brand-primary), var(--color-brand-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-sm);
    letter-spacing: -0.02em;
  }

  .stat-label {
    color: var(--color-gray-400);
    font-size: 0.95rem;
    font-weight: 400;
    text-transform: capitalize;
  }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-3xl);
  }

  .card-cta {
    margin-top: var(--space-md);
  }

  /* Work Grid */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--space-2xl);
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-3xl);
  }

  .work-item {
    background: var(--color-dark-secondary);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .work-item:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .work-image {
    width: 100%;
    height: 320px;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .work-image-1 {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.8), rgba(139, 92, 246, 0.8));
  }

  .work-image-2 {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.8), rgba(99, 102, 241, 0.8));
  }

  .work-image-3 {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.8), rgba(245, 158, 11, 0.8));
  }

  .work-info {
    padding: var(--space-xl);
  }

  .work-info h3 {
    color: var(--color-white);
    margin-bottom: var(--space-sm);
  }

  .work-info p {
    color: var(--color-gray-300);
    margin-bottom: var(--space-md);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-gray-400);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* Process Grid */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-3xl);
  }

  .process-step {
    text-align: center;
    padding: var(--space-xl);
  }

  .step-number {
    display: inline-block;
    width: 60px;
    height: 60px;
    line-height: 60px;
    background: linear-gradient(135deg, var(--color-brand-primary), var(--color-brand-secondary));
    color: var(--color-white);
    border-radius: 50%;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .process-step h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .process-step p {
    color: var(--color-gray-400);
    line-height: 1.7;
  }

  /* Contact Section */
  .contact-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .contact-cta {
    display: flex;
    justify-content: center;
    margin: var(--space-2xl) 0;
  }

  .contact-info {
    margin-top: var(--space-lg);
  }

  .contact-link {
    color: var(--color-white);
    text-decoration: underline;
    font-weight: 600;
  }

  .contact-link:hover {
    color: var(--color-accent-primary);
  }

  /* Responsive adjustments */
  @media (max-width: 767px) {
    .hero-cta {
      flex-direction: column;
    }

    .hero-cta :global(.btn) {
      width: 100%;
    }

    .work-grid,
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
