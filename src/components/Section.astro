---
export interface Props {
  background?: 'white' | 'gray' | 'dark' | 'gradient';
  padding?: 'sm' | 'md' | 'lg';
  class?: string;
  id?: string;
}

const {
  background = 'white',
  padding = 'lg',
  class: className = '',
  id
} = Astro.props;
---

<section class={`section section-${background} section-padding-${padding} ${className}`} id={id}>
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .section {
    width: 100%;
    position: relative;
  }

  /* Padding Options */
  .section-padding-sm {
    padding: var(--space-2xl) 0;
  }

  .section-padding-md {
    padding: var(--space-3xl) 0;
  }

  .section-padding-lg {
    padding: 5rem 0;
  }

  @media (min-width: 1024px) {
    .section-padding-lg {
      padding: 7rem 0;
    }
  }

  /* Background Options - Dark theme variations */
  .section-white {
    background: var(--color-black);
  }

  .section-gray {
    background: var(--color-dark-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .section-dark {
    background: var(--color-gray-900);
    color: var(--color-white);
  }

  .section-dark h1,
  .section-dark h2,
  .section-dark h3,
  .section-dark h4,
  .section-dark h5,
  .section-dark h6 {
    color: var(--color-white);
  }

  .section-dark p {
    color: var(--color-gray-400);
  }

  .section-gradient {
    background: linear-gradient(135deg, var(--color-brand-primary) 0%, var(--color-brand-secondary) 100%);
    color: var(--color-white);
    position: relative;
    overflow: hidden;
  }

  .section-gradient::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .section-gradient h1,
  .section-gradient h2,
  .section-gradient h3,
  .section-gradient h4,
  .section-gradient h5,
  .section-gradient h6 {
    color: var(--color-white);
  }

  .section-gradient p {
    color: rgba(255, 255, 255, 0.9);
  }
</style>
